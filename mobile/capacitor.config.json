{
  "appId": "com.gillylab.app",
  "appName": "GillyLab",
  "webDir": "www",
  "backgroundColor": "#0a0a0b",
  "ios": {
    "backgroundColor": "#0a0a0b",
    "contentInset": "never"
  },
  "android": {
    "backgroundColor": "#0a0a0b"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 400,
      "backgroundColor": "#0a0a0b",
      "androidScaleType": "CENTER_CROP",
      "androidSplashResourceName": "splash",
      "layoutName": "activity_splash",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#0a0a0b"
    }
  }
}
