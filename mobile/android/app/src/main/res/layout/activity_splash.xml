<?xml version="1.0" encoding="utf-8"?>
<!--
  Custom splash layout for the Capacitor SplashScreen plugin (see
  capacitor.config.json -> plugins.SplashScreen.layoutName). Reuses the exact
  same drawable/splash asset as the plain-ImageView default (all density/night
  variants keep working automatically), just adds the "Know the fight before
  it starts" slogan under the GILLYLAB wordmark that's already baked into that
  image. The two spacer Views use weights instead of a fixed dp offset so the
  slogan lands right under the wordmark (which ends at ~65.5% of the image's
  height) on any screen size, without pulling in a ConstraintLayout
  dependency this module doesn't already have.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/splash"
        android:contentDescription="@null" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="67" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="6dp"
            android:gravity="center_horizontal"
            android:text="Know the fight before it starts"
            android:textColor="#ffffff"
            android:textSize="15sp"
            android:fontFamily="sans-serif-medium" />

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="33" />

    </LinearLayout>

</FrameLayout>
