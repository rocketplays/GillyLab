<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="17132" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" launchScreen="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="01J-lp-oVM">
    <device id="retina4_7" orientation="portrait" appearance="light"/>
    <dependencies>
        <deployment identifier="iOS"/>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="17105"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <scenes>
        <!--View Controller-->
        <scene sceneID="EHf-IW-A2E">
            <objects>
                <viewController id="01J-lp-oVM" sceneMemberID="viewController">
                    <view key="view" userInteractionEnabled="NO" contentMode="scaleToFill" id="Gxr-0V-1cJ">
                        <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <subviews>
                            <imageView userInteractionEnabled="NO" contentMode="scaleAspectFill" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="Splash" translatesAutoresizingMaskIntoConstraints="NO" id="snD-IY-ifK">
                                <rect key="frame" x="0.0" y="0.0" width="375" height="667"/>
                            </imageView>
                            <!-- Two plain labels, not one attributedText label: a hand-authored
                                 NSAttributedString fragment block can't be verified without Xcode
                                 actually compiling this storyboard (ibtool), and a first attempt at
                                 it rendered as no subtext at all on a real device. Two ordinary
                                 single-color UILabels use the exact same simple text/textColor
                                 shape the original single label already used successfully, just
                                 duplicated: centered as a pair via the centerX +/-1pt trick below
                                 instead of a UIStackView, for the same reason (unverifiable schema). -->
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Know the fight " textAlignment="right" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="slG-an-tag">
                                <rect key="frame" x="27" y="410" width="160" height="20"/>
                                <fontDescription key="fontDescription" type="system" weight="medium" pointSize="15"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="before it starts" textAlignment="left" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="slG-an-tg2">
                                <rect key="frame" x="188" y="410" width="160" height="20"/>
                                <fontDescription key="fontDescription" type="system" weight="medium" pointSize="15"/>
                                <color key="textColor" red="0.0" green="0.90196078431372551" blue="0.40392156862745099" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <nil key="highlightedColor"/>
                            </label>
                        </subviews>
                        <color key="backgroundColor" red="0.0392156862745098" green="0.0392156862745098" blue="0.043137254901960784" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="leading" secondItem="Gxr-0V-1cJ" secondAttribute="leading" id="c01-le-ad0"/>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="trailing" secondItem="Gxr-0V-1cJ" secondAttribute="trailing" id="c02-tr-ai1"/>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="top" secondItem="Gxr-0V-1cJ" secondAttribute="top" id="c03-to-p02"/>
                            <constraint firstItem="snD-IY-ifK" firstAttribute="bottom" secondItem="Gxr-0V-1cJ" secondAttribute="bottom" id="c04-bo-t03"/>
                            <!-- Pair of labels centered as a unit: label1's trailing sits 1pt left
                                 of view.centerX, label2's leading sits 1pt right of it, reading
                                 as one centered "Know the fight before it starts" line with a
                                 2pt gap, same visual effect a single centered label had, without
                                 needing a UIStackView (see the label comment above for why not). -->
                            <constraint firstItem="slG-an-tag" firstAttribute="trailing" secondItem="Gxr-0V-1cJ" secondAttribute="centerX" constant="-1" id="c05-cx-04"/>
                            <!-- 1.26, not the old 1.46: the splash image's logo/wordmark moved up
                                 (see mobile/assets/splash.png), so this needs to move up with it to
                                 stay a subtext right under the wordmark instead of drifting further
                                 down the now-larger gap. multiplier/2 = fraction of screen height
                                 (centerY = view.centerY * multiplier = viewHeight * multiplier/2). -->
                            <constraint firstItem="slG-an-tag" firstAttribute="centerY" secondItem="Gxr-0V-1cJ" secondAttribute="centerY" multiplier="1.26" constant="0.0" id="c06-cy-05"/>
                            <constraint firstItem="slG-an-tag" firstAttribute="leading" relation="greaterThanOrEqual" secondItem="Gxr-0V-1cJ" secondAttribute="leadingMargin" constant="16" id="c07-lm-06"/>
                            <constraint firstItem="slG-an-tg2" firstAttribute="leading" secondItem="Gxr-0V-1cJ" secondAttribute="centerX" constant="1" id="c09-cx-08"/>
                            <constraint firstItem="slG-an-tg2" firstAttribute="centerY" secondItem="Gxr-0V-1cJ" secondAttribute="centerY" multiplier="1.26" constant="0.0" id="c10-cy-09"/>
                            <constraint firstItem="slG-an-tg2" firstAttribute="trailing" relation="lessThanOrEqual" secondItem="Gxr-0V-1cJ" secondAttribute="trailingMargin" constant="-16" id="c11-tm-10"/>
                        </constraints>
                    </view>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="iYj-Kq-Ea1" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="53" y="375"/>
        </scene>
    </scenes>
    <resources>
        <image name="Splash" width="1366" height="1366"/>
        <systemColor name="systemBackgroundColor">
            <color white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
        </systemColor>
    </resources>
</document>
