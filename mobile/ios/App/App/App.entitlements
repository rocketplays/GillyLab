<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- "development" here; Xcode re-signs archives/TestFlight/App Store builds with the
	     production APNs environment automatically (it follows the provisioning profile). -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
